---
import { publishedProjects } from '../data/projects';
---
{publishedProjects.length > 0 && <div class="grid gap-6 md:grid-cols-3">{publishedProjects.map(project => <article class="service"><span class="eyebrow">{project.kind === 'demo' ? '自主制作デモ' : 'クライアント実績'}</span><h3>{project.title}</h3><p>{project.description}</p><a href={project.url}>詳細を見る →</a></article>)}</div>}
