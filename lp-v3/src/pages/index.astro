---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import ProjectList from '../components/ProjectList.astro';
import { publishedProjects } from '../data/projects';
import { profile } from '../data/profile';
const hasProjects = publishedProjects.length > 0;
const services = [
 {number:'01', icon:'▤', title:['LP・Webページ', '制作／改善'], description:'伝えたいことを整理し、問い合わせ・応募につながるページと導線をつくります。', items:['LP・Webページの企画、制作','既存ページの構成・デザイン改善','問い合わせ・応募導線の整備'], tag:'伝わるページをつくる'},
 {number:'02', icon:'↗', title:['Web広告・', '集客運用支援'], description:'届けたい相手と事業の目的から、広告とページを一緒に考え、改善を重ねます。', items:['Meta・Google広告の運用支援','広告とLPのメッセージ整理','配信後の振り返り・改善提案'], tag:'必要な相手に届ける'},
 {number:'03', icon:'⇄', title:['メール・MA・', '業務自動化'], description:'日々の対応を整理し、お客様との接点づくりと、無理なく続けられる仕組みを支えます。', items:['メール配信・MAの設計、設定','問い合わせ後の対応フロー整備','ツール連携・定型業務の自動化'], tag:'続けられる仕組みにする'}
];
const steps = [['ご相談・ヒアリング','目的や現状、お困りごとを伺います。内容が整理できていなくても大丈夫です。'],['ご提案・お見積もり','必要な業務と進め方、費用をご案内。対応範囲を合意してから開始します。'],['制作・実装・運用','方向性を確認しながら、制作や設定、運用の実務を進めます。'],['確認・納品','制作・実装内容をご確認いただき、納品。運用支援では、実施内容と振り返りを共有します。'],['次の一手をご案内','今後取り組める改善を整理。必要に応じて、次の施策をご相談いただけます。']];
---
<Layout>
<section id="top" class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span> WEB PRODUCTION & MARKETING SUPPORT</p><h1><span class="hero-line">作って終わりにしない。</span><span>集客も、採用も。</span></h1><p class="hero-heading">事業の目的から考える<br/>Web制作・運用支援。</p><p class="hero-description">LP制作・改善からMeta・Google広告の運用、<br class="desktop-break"/>問い合わせ・応募導線の整備まで。<br/>小規模事業者・中小企業のWeb施策を、<br class="desktop-break"/>企画から実務までサポートします。</p><div class="hero-actions"><a class="button" href="#contact">まずは相談する <span aria-hidden="true">↗</span></a><a class="text-link" href="#services">依頼できる業務を見る <span aria-hidden="true">↓</span></a></div><p class="hero-note">制作だけ、運用だけ、改善だけのご相談も。</p></div><div class="hero-visual" aria-label="事業の目的を中心に、制作・集客・仕組みづくりをつなぐ支援の概念図" role="img"><div class="visual-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="visual-center"><span>YOUR BUSINESS</span><strong>事業の目的</strong><small>ここから、一緒に。</small></div><div class="visual-card card-web"><span class="mini-icon">▤</span><div><small>CREATE</small><strong>伝わるWeb制作</strong></div></div><div class="visual-card card-marketing"><span class="mini-icon">↗</span><div><small>CONNECT</small><strong>集客・採用の導線</strong></div></div><div class="visual-card card-operation"><span class="mini-icon">⇄</span><div><small>IMPROVE</small><strong>続けられる仕組み</strong></div></div><span class="visual-caption">MAKE IT. CONNECT IT. KEEP IMPROVING.</span></div></div><div class="wrap hero-bottom"><span>企画から、制作、その先の改善まで。</span><span>小規模事業者・中小企業のWebパートナー</span><a href="#services">SCROLL ↓</a></div></section>
<section id="services" class="section bg-soft"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">01 / SERVICES</p><h2>必要なところから、<br/>頼めるWebパートナー。</h2></div><p>すべてをまとめて依頼する必要はありません。<br/>単発のご相談から制作・実装、継続支援まで。<br/>今の課題に合わせて、必要な支援を組み立てます。</p></div><div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{services.map(s => <article class="service"><div class="service-top"><span class="service-icon" aria-hidden="true">{s.icon}</span><span class="service-number">{s.number}</span></div><p class="service-tag">{s.tag}</p><h3>{s.title.map((part, i) => <><span>{part}</span>{i === 0 && <wbr/>}</>)}</h3><p>{s.description}</p><ul>{s.items.map(item => <li>{item}</li>)}</ul><a href="#contact">この業務について相談する <span aria-hidden="true">↗</span></a></article>)}</div><p class="service-bottom">「何から始めればよいか」という段階から、ご相談いただけます。</p></div></section>
{hasProjects && <section id="works" class="section works"><div class="wrap"><p class="eyebrow">02 / WORKS</p><div class="works-inner"><h2>制作・支援実績</h2></div><ProjectList/></div></section>}
<section id="about" class="section about"><div class="wrap about-grid"><div class="about-panel"><p>CONNECT MARKETING</p><div class="about-monogram" aria-hidden="true">c<span>m</span></div><span>事業の視点と、実務の力を。</span></div><div><p class="eyebrow">{hasProjects ? '03' : '02'} / ABOUT</p><h2>経営の視点を持ちながら、<br/>制作・運用の実務まで。</h2><p class="representative">{profile.role}<strong class="representative-name">{profile.name}</strong></p><div class="profile-details">{profile.sections.map(section => <div class="profile-detail"><h3>{section.heading}</h3><p>{section.body}</p></div>)}</div><a class="text-link" href="https://note.com/houmeinobusiness" target="_blank" rel="noopener noreferrer">代表の考えをnoteで読む <span aria-hidden="true">↗</span></a></div></div></section>
<section id="process" class="section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{hasProjects ? '04' : '03'} / PROCESS</p><h2>相談から、その次の一手まで。</h2></div><p>進め方と対応範囲を、<br/>一つひとつ確認しながら進めます。</p></div><ol class="steps">{steps.map(([title,body],i) => <li><span class="step-number">0{i+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol><div class="process-note"><strong>納品後も、次に何をすればよいかがわかるように。</strong><p>制作・実装案件では、簡潔な「次の一手メモ」をお渡しします。継続契約は必須ではありません。追加作業は、別途合意・お見積もりのうえ対応します。</p></div></div></section>
<section id="contact" class="section contact"><div class="wrap contact-grid"><div><p class="eyebrow">{hasProjects ? '05' : '04'} / CONTACT</p><h2>まだ、まとまって<br/>いないご相談でも。</h2><p>「ページを見直したい」「広告を始めたい」<br/>「日々の対応を、もう少し楽にしたい」。<br/>今のお困りごとを、お聞かせください。</p><div class="contact-note"><strong>お問い合わせについて</strong><p>フォームはTallyを利用しています。個人情報の取り扱いは<a href="/privacy/">プライバシーポリシー</a>をご確認ください。</p></div></div><ContactForm/></div></section>
</Layout>
