---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title = 'Connect Marketing｜事業の目的から考えるWeb制作・運用支援', description = 'LP制作・改善からMeta・Google広告の運用、メール・MA・業務自動化まで。小規模事業者・中小企業の集客と採用を、企画から実務までサポートします。' } = Astro.props;

---
<!doctype html><html lang="ja"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href}/><meta property="og:type" content="website"/><meta property="og:locale" content="ja_JP"/><meta property="og:site_name" content="Connect Marketing"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href}/><meta name="theme-color" content="#173047"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head><body><a class="skip-link" href="#main">本文へスキップ</a><Header/><main id="main"><slot/></main><Footer/></body></html>
